# =============================================================================
# Environment Variables for BDBV Host Prediction
# =============================================================================

# Project Settings
BDBV_HOME=/path/to/project
BDBV_ENV=development
BDBV_DEBUG=True

# Data Paths
BDBV_DATA_DIR=/path/to/data
BDBV_RAW_DATA_DIR=/path/to/data/raw
BDBV_PROCESSED_DATA_DIR=/path/to/data/processed
BDBV_EXTERNAL_DATA_DIR=/path/to/data/external

# Results Paths
BDBV_RESULTS_DIR=/path/to/results
BDBV_FIGURES_DIR=/path/to/results/figures
BDBV_MODELS_DIR=/path/to/results/models

# Logging
BDBV_LOG_LEVEL=INFO
BDBV_LOG_DIR=/path/to/logs

# Model Settings
BDBV_RANDOM_SEED=42
BDBV_TEST_SIZE=0.25
BDBV_N_FOLDS=5

# Database (Optional)
BDBV_DB_HOST=localhost
BDBV_DB_PORT=5432
BDBV_DB_NAME=bdbv_hosts
BDBV_DB_USER=bdbv_user
BDBV_DB_PASSWORD=bdbv_password

# API Settings (Optional)
BDBV_API_HOST=0.0.0.0
BDBV_API_PORT=8000
BDBV_API_DEBUG=True